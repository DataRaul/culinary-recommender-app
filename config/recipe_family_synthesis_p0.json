{
  "contractVersion": "0.2.0",
  "pilotId": "recipe-family-synthesis-p0",
  "state": "CONTRACT_ONLY_NO_RUNTIME_AUTHORITY",
  "objective": "Prove that a small bounded multi-source evidence set can produce legally clean, practically reliable recipe-family models and app-owned recipe projections without corpus-scale growth.",
  "parallelWith": ["STEP_8G"],
  "mustNotMutate": [
    "protected_production_population",
    "step8g_active_state",
    "shard_topology",
    "public_runtime_recipe_count",
    "billing_state",
    "nutrition_authority_policy"
  ],
  "pilotFamilies": [
    "carbonara",
    "pizza_margherita",
    "cacio_e_pepe",
    "pesto_genovese",
    "hummus",
    "guacamole",
    "tortilla_espanola",
    "pancakes",
    "basic_tomato_pasta_sauce",
    "ragu_bolognese_family"
  ],
  "sourceTarget": {
    "strongReferenceWhereAvailable": 1,
    "independentPracticalMinimum": 3,
    "independentPracticalDefaultMaximum": 5,
    "stopWhenMarginalInformationGainLow": true,
    "deduplicateByIndependenceGroup": true
  },
  "sourceRoles": [
    "REFERENCE_EVIDENCE",
    "STRUCTURE_EVIDENCE",
    "VARIANT_EVIDENCE",
    "VALIDATION_ONLY",
    "REUSABLE_CONTENT",
    "DO_NOT_USE"
  ],
  "acquisitionModes": [
    "MANUAL_REVIEW",
    "AUTOMATED_TDM",
    "API_OPEN_DATA",
    "LICENSED_REUSE"
  ],
  "legalFields": {
    "lawfulAccess": ["YES", "NO", "UNKNOWN"],
    "termsState": ["ALLOWS_INTENDED_USE", "NO_RELEVANT_RESTRICTION_FOUND", "PROHIBITS_AUTOMATION", "REQUIRES_PERMISSION", "UNKNOWN"],
    "tdmReservation": ["NONE_FOUND", "EXPRESSLY_RESERVED", "UNKNOWN", "NOT_APPLICABLE"],
    "reuseBasis": ["OPEN_LICENCE", "PERMISSION", "PUBLIC_DOMAIN", "STANDARD_COPYRIGHT", "UNKNOWN"],
    "databaseExtractionRisk": ["LOW", "MATERIAL", "UNKNOWN"],
    "cumulativeExtractionRisk": ["LOW", "MATERIAL", "UNKNOWN"],
    "rawExpressionRetention": ["NONE", "TEMPORARY_DELETE_AFTER_NORMALIZATION"]
  },
  "requiredSourceMetadata": [
    "publisher",
    "url",
    "accessedAt",
    "independenceGroup",
    "publisherLedgerKey",
    "acquisitionMode",
    "lawfulAccess",
    "termsState",
    "reuseBasis",
    "databaseExtractionRisk",
    "cumulativeExtractionRisk",
    "role",
    "sourceExpressionPersisted",
    "rawExpressionRetention"
  ],
  "automatedTdmAdditionalMetadata": [
    "termsCheckedAt",
    "tdmReservation",
    "tdmReservationCheckedAt",
    "tdmReservationEvidence"
  ],
  "legalRules": [
    "NO_LAWFUL_ACCESS_DO_NOT_USE",
    "AUTOMATED_TDM_REQUIRES_TERMS_ALLOW_OR_NO_RELEVANT_RESTRICTION",
    "EXPRESS_OR_UNKNOWN_TDM_RESERVATION_BLOCKS_GENERAL_AUTOMATED_TDM_LANE",
    "AUTOMATED_TDM_REQUIRES_CURRENT_RESERVATION_EVIDENCE",
    "REUSABLE_CONTENT_REQUIRES_OPEN_LICENCE_PERMISSION_OR_PUBLIC_DOMAIN",
    "DO_NOT_RETAIN_OR_REPUBLISH_PROTECTED_SOURCE_EXPRESSION_WITHOUT_REUSE_RIGHTS",
    "TEMPORARY_FETCHED_EXPRESSION_DELETE_AFTER_NORMALIZATION",
    "DO_NOT_RECONSTRUCT_THIRD_PARTY_DATABASE_BY_SUBSTANTIAL_OR_REPEATED_SYSTEMATIC_EXTRACTION",
    "TRACK_CUMULATIVE_EXTRACTION_BY_PUBLISHER_LEDGER_KEY",
    "MATERIAL_OR_UNKNOWN_EXTRACTION_RISK_FAILS_CLOSED",
    "MATERIAL_UNCERTAINTY_FAILS_CLOSED_FOR_THE_SOURCE_NOT_THE_FAMILY"
  ],
  "compliancePreflight": {
    "mandatoryBeforeAutomatedSourceAcquisition": true,
    "policy": "docs/RECIPE_FAMILY_SOURCE_COMPLIANCE_GATE.md",
    "validator": "scripts/validate-recipe-family-source-compliance.mjs",
    "sourceLevelFailureDoesNotBlockFamily": true,
    "manualBoundedEvidencePathRemainsAvailable": true
