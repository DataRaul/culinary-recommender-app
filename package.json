{
  "name": "culinary-recommender-app",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Deterministic mobile-first culinary recommendation and meal-planning PWA.",
  "scripts": {
    "check": "node scripts/check-static.mjs",
    "test": "node --test tests/*.test.js",
    "test:matrix": "node tests/profile-matrix.test.js",
    "test:browser": "node scripts/browser-smoke.mjs && node scripts/browser-acceptance.mjs && node scripts/browser-gate-f-acceptance.mjs",
    "report:nutrition-coverage": "node scripts/report-nutrition-coverage.mjs",
    "report:recipe-universe": "node scripts/report-recipe-universe-coverage.mjs",
    "report:recipe-corpus-f2": "node scripts/report-wikibooks-gate-f2-coverage.mjs",
    "build:recipe-corpus-f2": "node scripts/build-wikibooks-gate-f2-index.mjs",
    "discover:recipe-corpus-f2": "node scripts/discover-wikibooks-gate-f2.mjs",
    "queue:recipe-corpus-f2": "node scripts/build-wikibooks-gate-f2-review-queue.mjs",
    "verify:wikibooks-gate-f": "node scripts/verify-wikibooks-gate-f-snapshot.mjs",
    "validate": "npm run check && npm test"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
