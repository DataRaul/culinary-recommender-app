{
  "schema_version": 3,
  "policy_id": "CULINARY_HANDOVER_CIRCUIT_BREAKER_V3",
  "status": "ACTIVE",
  "purpose": "Guarantee frequent user-visible resumability by ending every Culinary chat execution cycle after one bounded package instead of depending on context-window detection.",
  "primary_mechanism": {
    "type": "ONE_BOUNDED_PACKAGE_THEN_HANDOVER_AND_STOP",
    "max_packages_per_chat_execution_cycle": 1,
    "successor_may_start_same_cycle": false,
    "mandatory_user_visible_handover": true,
    "stop_after_handover": true,
    "handover_state_branch": "continuity-state",
    "current_path": "docs/handovers/CURRENT.json",
    "previous_path": "docs/handovers/PREVIOUS.json",
    "terminal_boundaries": [
      "bounded_package_terminal",
      "material_pr_merged_or_closed",
      "human_error_cost_or_security_gate",
      "stable_external_waiting_state",
      "early_context_or_tool_history_risk"
    ]
  },
  "loop_breakers": {
    "external_status_polling": {
      "max_unchanged_rechecks_per_cycle": 1,
      "on_limit": "PERSIST_HANDOVER_EMIT_AND_STOP"
    },
    "repair_revalidation": {
      "max_equivalent_repair_cycles_per_package": 1,
      "on_recurrence_or_uncertainty": "PERSIST_HANDOVER_EMIT_AND_STOP"
    }
  },
  "secondary_context_trigger": {
    "telemetry": {
      "use_when_available": true,
      "preferred_trigger_fraction": 0.5,
      "rule": "50% is an intentionally early optional trigger, not a target to maximize. Earlier handover is acceptable."
    },
    "heuristic_fallback": {
      "enabled": true,
      "invent_percentage": false,
      "rule": "If context/tool history is becoming difficult to retain exactly, hand over at the nearest safe boundary immediately."
    }
  },
  "handover": {
    "fresh_reconcile_before_write": true,
    "rotate_current_to_previous": true,
    "verify_read_after_write": true,
    "emit_same_complete_current_object": true,
    "user_output_format": "single_complete_json_object",
    "no_narration_does_not_suppress_terminal_handover": true
  },
  "cost_and_execution": {
    "github_actions_required": false,
    "scheduled_context_polling_forbidden": true,
    "background_context_retriever_forbidden": true,
    "continuity_branch_commit_message_suffix": "[skip ci]",
    "main_branch_role": "authoritative project state",
    "continuity_branch_role": "durable resumability state only"
  }
}
